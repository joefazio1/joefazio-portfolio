---
// The shared shell for every page. Pages supply a title, an optional
// description, and their content; everything else lives here once.
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Joe Fazio — IT and infrastructure work.' } = Astro.props;

// Every page in the nav, in order. Adding a page means adding one line here.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
];

// Used to mark the current page for screen readers and styling.
// Astro serves pages with a trailing slash ('/about/'), while the nav
// hrefs have none, so both sides get normalised before comparing.
const strip = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const path = strip(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header>
      <a class="wordmark" href="/">joe fazio</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path === strip(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <ul>
        <li><a href="mailto:joefazio512@gmail.com">email</a></li>
        <li><a href="https://github.com/joefazio1">github</a></li>
        <li><a href="https://linkedin.com/in/joefazio878">linkedin</a></li>
      </ul>
    </footer>

    <style is:global>
      /* Navy is the anchor. Brass warms it, sea green is the quiet
         second voice. Light mode is the same palette on paper. */
      :root {
        --bg: #f4f7fb;
        --surface: #e8eef6;
        --fg: #0d1b2a;
        --dim: #4d6076;
        --rule: #cfdae8;
        --accent: #9a5f10;
        --accent-2: #1f6f74;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1b2a;
          --surface: #142639;
          --fg: #e7eef6;
          --dim: #93a8c0;
          --rule: #23394f;
          --accent: #e3a85c;
          --accent-2: #6fb5ba;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0 1.5rem;
        background: var(--bg);
        color: var(--fg);
        font:
          17px/1.7 system-ui,
          -apple-system,
          'Segoe UI',
          Helvetica,
          Arial,
          sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      header,
      main,
      footer {
        width: 100%;
        max-width: 42rem;
        margin: 0 auto;
      }

      header {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: baseline;
        justify-content: space-between;
        padding: 2.5rem 0 1.25rem;
        border-bottom: 1px solid var(--rule);
      }

      .wordmark {
        font-weight: 600;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        color: var(--fg);
        display: inline-flex;
        align-items: center;
      }

      .wordmark::before {
        content: '';
        display: inline-block;
        width: 0.55rem;
        height: 0.55rem;
        margin-right: 0.5rem;
        border-radius: 2px;
        background: var(--accent);
      }

      nav ul,
      footer ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      nav a {
        color: var(--dim);
        text-decoration: none;
      }

      nav a:hover,
      nav a[aria-current='page'] {
        color: var(--fg);
      }

      nav a[aria-current='page'] {
        border-bottom: 2px solid var(--accent);
        padding-bottom: 2px;
      }

      main {
        flex: 1;
        padding: 3rem 0;
      }

      h1 {
        font-size: 2rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
      }

      h2 {
        font-size: 1.25rem;
        letter-spacing: -0.01em;
        margin: 2.5rem 0 0.75rem;
      }

      main a {
        color: var(--accent-2);
        text-underline-offset: 3px;
      }

      main a:hover {
        color: var(--accent);
      }

      footer {
        padding: 1.25rem 0 2.5rem;
        border-top: 1px solid var(--rule);
        color: var(--dim);
      }

      footer a {
        color: var(--dim);
      }

      footer a:hover {
        color: var(--fg);
      }

      .skip {
        position: absolute;
        left: -9999px;
      }

      .skip:focus {
        left: 1rem;
        top: 1rem;
        background: var(--bg);
        padding: 0.5rem;
      }
    </style>
  </body>
</html>
