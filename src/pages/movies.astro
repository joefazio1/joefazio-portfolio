---
import Layout from '../layouts/Layout.astro';

// My top 25, in rough order. `note` is a one-line reason, filled in over time.
// Leave a note empty and the row simply renders without one.
const films = [
  { title: 'Memento', year: 2000, note: '' },
  { title: 'The Dark Knight', year: 2008, note: '' },
  { title: 'Harry Potter and the Prisoner of Azkaban', year: 2004, note: '' },
  { title: 'WALL-E', year: 2008, note: '' },
  { title: 'Inception', year: 2010, note: '' },
  { title: 'Jurassic Park', year: 1993, note: '' },
  { title: 'Knives Out', year: 2019, note: '' },
  { title: 'The Godfather', year: 1972, note: '' },
  { title: 'The Empire Strikes Back', year: 1980, note: '' },
  { title: 'The Batman', year: 2022, note: '' },
  { title: 'Dead Poets Society', year: 1989, note: '' },
  { title: 'Avengers: Infinity War', year: 2018, note: '' },
  { title: 'Avengers: Endgame', year: 2019, note: '' },
  { title: '12 Angry Men', year: 1957, note: '' },
  { title: 'Harry Potter and the Deathly Hallows: Part 2', year: 2011, note: '' },
  { title: 'Inglourious Basterds', year: 2009, note: '' },
  { title: "Pirates of the Caribbean: At World's End", year: 2007, note: '' },
  { title: "Pirates of the Caribbean: Dead Man's Chest", year: 2006, note: '' },
  { title: 'The Hateful Eight', year: 2015, note: '' },
  { title: 'My Cousin Vinny', year: 1992, note: '' },
  { title: 'GoodFellas', year: 1990, note: '' },
  { title: 'Uncut Gems', year: 2019, note: '' },
  { title: 'Fargo', year: 1996, note: '' },
  { title: 'Rocky', year: 1976, note: '' },
  { title: 'Rango', year: 2011, note: '' },
];
---

<Layout
  title="Top 25 Movies | Joe Fazio"
  description="Joe Fazio's twenty-five favorite movies of all time."
>
  <p class="back"><a href="/records">Back to The Record Store</a></p>

  <h1>Top 25 Movies</h1>
  <p class="lede">
    My twenty-five favorite movies of all time. Ask me about any of them and I
    will not stop talking. Notes are getting added as I write them.
  </p>

  <ol class="ranked">
    {
      films.map((f, i) => (
        <li>
          <span class="rank">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">
              {f.title} <span class="year">({f.year})</span>
            </span>
            {f.note && <span class="note">{f.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="back"><a href="/records">Back to The Record Store</a></p>
</Layout>

<style>
  .back {
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .lede {
    color: var(--dim);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .ranked {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    counter-reset: none;
  }

  .ranked li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ranked li:last-child {
    border-bottom: none;
  }

  .rank {
    flex: 0 0 2.1rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* The year sits quietly beside the title. */
  .year {
    font-weight: 400;
    color: var(--dim);
  }

  .note {
    font-size: 0.85rem;
    color: var(--dim);
    line-height: 1.55;
  }
</style>
