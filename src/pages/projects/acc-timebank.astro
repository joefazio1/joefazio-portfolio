    color: var(--dim);
    padding-top: 0.2rem;
  }

  .spec dd {
    flex: 1;
    min-width: 12rem;
    margin: 0;
  }

  .states {
    counter-reset: state;
    list-style: none;
    padding-left: 0;
  }

  .states li {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .states li::before {
    counter-increment: state;
    content: counter(state);
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1.5rem;
    height: 1.5rem;
