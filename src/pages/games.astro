---
import Layout from '../layouts/Layout.astro';

// My top 25, in rough order. `note` is a one-line reason, filled in over time.
// Leave a note empty and the row simply renders without one.
// `year` prints as written, so a collection can carry more than one year.
const games = [
  { title: 'The Legend of Zelda: Breath of the Wild', year: 2017, note: '' },
  { title: 'Red Dead Redemption 2', year: 2018, note: '' },
  { title: 'Super Smash Bros. Ultimate', year: 2018, note: '' },
  { title: 'Hades', year: 2020, note: '' },
  { title: 'God of War Ragnarok', year: 2022, note: '' },
  { title: 'God of War', year: 2018, note: '' },
  { title: 'Super Mario Maker', year: 2015, note: '' },
  { title: "Marvel's Spider-Man", year: 2018, note: '' },
  { title: 'Pokemon Black Version 2', year: 2012, note: '' },
  { title: 'BioShock', year: 2007, note: '' },
  { title: 'Celeste', year: 2018, note: '' },
  { title: 'Counter-Strike 2', year: 2023, note: '' },
  { title: 'The Legend of Zelda: Tears of the Kingdom', year: 2023, note: '' },
  { title: 'Hollow Knight', year: 2017, note: '' },
  { title: 'Katana Zero', year: 2019, note: '' },
  { title: 'Metroid Dread', year: 2021, note: '' },
  { title: 'Minecraft', year: 2011, note: '' },
  { title: 'Terraria', year: 2011, note: '' },
  { title: 'BioShock Infinite: The Complete Edition', year: '2013-2014', note: '' },
  { title: "Marvel's Spider-Man: Miles Morales", year: 2020, note: '' },
  { title: 'Batman: Arkham Trilogy', year: '2009, 2011, 2015', note: '' },
  { title: 'Bloons TD 6', year: 2018, note: '' },
  { title: 'Before Your Eyes', year: 2021, note: '' },
  { title: "BioShock 2: Minerva's Den", year: 2010, note: '' },
  { title: 'Clash of Clans', year: 2012, note: '' },
];
---

<Layout
  title="Top 25 Games | Joe Fazio"
  description="Joe Fazio's twenty-five favorite video games of all time."
>
  <p class="back"><a href="/records">Back to The Record Store</a></p>

  <h1>Top 25 Games</h1>
  <p class="lede">
    My twenty-five favorite games of all time. Subjective, and ranked on more
    than just how fun they were to play: the gameplay, the story, the
    nostalgia, and what they left with me. Notes are getting added as I write
    them.
  </p>

  <ol class="ranked">
    {
      games.map((g, i) => (
        <li>
          <span class="rank">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">
              {g.title} <span class="year">({g.year})</span>
            </span>
            {g.note && <span class="note">{g.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="back"><a href="/records">Back to The Record Store</a></p>
</Layout>

<style>
  .back {
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .lede {
    color: var(--dim);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .ranked {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .ranked li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ranked li:last-child {
    border-bottom: none;
  }

  .rank {
    flex: 0 0 2.1rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* The year sits quietly beside the title. */
  .year {
    font-weight: 400;
    color: var(--dim);
  }

  .note {
    font-size: 0.85rem;
    color: var(--dim);
    line-height: 1.55;
  }
</style>
