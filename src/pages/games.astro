---
import Layout from '../layouts/Layout.astro';

// My top 25, in rough order. `note` is a one-line reason, filled in over time.
// Leave a note empty and the row simply renders without one.
const games = [
  { title: 'The Legend of Zelda: Breath of the Wild', note: '' },
  { title: 'Red Dead Redemption 2', note: '' },
  { title: 'Super Smash Bros. Ultimate', note: '' },
  { title: 'Hades', note: '' },
  { title: 'God of War Ragnarok', note: '' },
  { title: 'God of War', note: '' },
  { title: 'Super Mario Maker', note: '' },
  { title: "Marvel's Spider-Man", note: '' },
  { title: 'Pokemon Black Version 2', note: '' },
  { title: 'BioShock', note: '' },
  { title: 'Celeste', note: '' },
  { title: 'Counter-Strike 2', note: '' },
  { title: 'The Legend of Zelda: Tears of the Kingdom', note: '' },
  { title: 'Hollow Knight', note: '' },
  { title: 'Katana Zero', note: '' },
  { title: 'Metroid Dread', note: '' },
  { title: 'Minecraft', note: '' },
  { title: 'Terraria', note: '' },
  { title: 'BioShock Infinite: The Complete Edition', note: '' },
  { title: "Marvel's Spider-Man: Miles Morales", note: '' },
  { title: 'Batman: Arkham Trilogy', note: '' },
  { title: 'Bloons TD 6', note: '' },
  { title: 'Before Your Eyes', note: '' },
  { title: "BioShock 2: Minerva's Den", note: '' },
  { title: 'Clash of Clans', note: '' },
];
---

<Layout
  title="Top 25 Games | Joe Fazio"
  description="Joe Fazio's twenty-five favorite video games, in rough order."
>
  <p class="back"><a href="/">Back to the crate</a></p>

  <h1>Top 25 Games</h1>
  <p class="lede">
    The twenty-five I keep coming back to, in rough order. A mix of the huge and
    the tiny, which is most of what I look for. Notes are getting added as I
    write them.
  </p>

  <ol class="ranked">
    {
      games.map((g, i) => (
        <li>
          <span class="rank">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">{g.title}</span>
            {g.note && <span class="note">{g.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="back"><a href="/">Back to the crate</a></p>
</Layout>

<style>
  .back {
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .lede {
    color: var(--dim);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .ranked {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .ranked li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ranked li:last-child {
    border-bottom: none;
  }

  .rank {
    flex: 0 0 2.1rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .note {
    font-size: 0.85rem;
    color: var(--dim);
    line-height: 1.55;
  }
</style>
