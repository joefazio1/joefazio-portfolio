---
import Layout from '../layouts/Layout.astro';

// A crate of records. Each sleeve is a subject; a record peeks out of the top
// and, when clicked, slides the rest of the way out before the page redirects
// to the list. `href: null` is a sleeve whose list is not built yet.
const sleeves = [
  { title: "Joe's Top 25 Movies", kicker: 'Top 25', href: '/movies', hue: 'rust' },
  { title: "Joe's Top 25 Video Games", kicker: 'Top 25', href: '/games', hue: 'green' },
  { title: "Joe's Top 25 Albums", kicker: 'Top 25', href: '/albums', hue: 'plum' },
  { title: 'My Record Collection', kicker: 'Coming soon', href: null, hue: 'teal' },
];
---

<Layout
  title="The Record Store | Joe Fazio"
  description="A crate of Joe Fazio's favorites: top 25 movies, video games and albums, with more to come. Pick a record."
>
  <h1>The Record Store</h1>
  <p class="hi">Pick a record.</p>

  <section class="crate" aria-label="Pick a record">
    <ul>
      {
        sleeves.map((s) =>
          s.href ? (
            <li>
              <a class={`item ${s.hue}`} href={s.href}>
                <span class="sleeve">
                  <span class="vinyl" aria-hidden="true">
                    <span class="vlabel" />
                  </span>
                  <span class="cover">
                    <span class="kicker">{s.kicker}</span>
                    <span class="title">{s.title}</span>
                  </span>
                </span>
              </a>
            </li>
          ) : (
            <li>
              <div class={`item soon ${s.hue}`}>
                <span class="sleeve">
                  <span class="cover">
                    <span class="kicker">{s.kicker}</span>
                    <span class="title">{s.title}</span>
                  </span>
                </span>
              </div>
            </li>
          )
        )
      }
    </ul>
  </section>
</Layout>

<script>
  // Progressive enhancement: slide the record out, then navigate. With no JS,
  // or with reduced motion, the link just navigates as normal.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.item[href]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const me = e as MouseEvent;
      if (reduce || me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
      e.preventDefault();
      el.classList.add('playing');
      const href = el.getAttribute('href');
      window.setTimeout(() => {
        if (href) window.location.href = href;
      }, 520);
    });
  });

  // Going Back (or mouse button 4) can restore this page from the browser's
  // back/forward cache exactly as it was left, record still out of the
  // sleeve. When that happens, put every record back.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    document.querySelectorAll('.item.playing').forEach((el) => el.classList.remove('playing'));
  });
</script>

<style>
  h1 {
    margin-bottom: 0.75rem;
  }

  .hi {
    font-size: 1.08rem;
    color: var(--fg);
    margin: 0 0 2rem;
  }

  /* THE CRATE: a shallow bin the sleeves stand in. */
  .crate {
    position: relative;
    padding: 3.5rem 1.35rem 1.6rem;
    border: 1px solid var(--rule);
    border-bottom-width: 4px;
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }

  .crate ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem 1.25rem;
    align-items: end;
  }

  .item {
    display: block;
    text-decoration: none;
    color: var(--fg);
  }

  .sleeve {
    position: relative;
    display: block;
  }

  /* THE RECORD: sits behind the cover, top arc peeking above the sleeve. */
  .vinyl {
    position: absolute;
    left: 50%;
    top: -13%;
    width: 84%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    z-index: 1;
    background:
      repeating-radial-gradient(
        circle at center,
        #15161a 0,
        #15161a 1px,
        #202127 2px,
        #202127 3px
      ),
      radial-gradient(circle at 34% 30%, #34363e, #0f1015 62%);
    box-shadow: 0 4px 12px rgba(13, 27, 42, 0.3);
    transition: top 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .vlabel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34%;
    height: 34%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  /* THE COVER: an opaque jacket that hides most of the record. */
  .cover {
    position: relative;
    z-index: 2;
    aspect-ratio: 1;
    border-radius: 5px;
    background: #14161c;
    box-shadow: 0 8px 18px rgba(13, 27, 42, 0.26);
    padding: 0.85rem 0.9rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  /* A hue glow in the corner so each jacket reads differently. */
  .cover::after {
    content: '';
    position: absolute;
    right: -30%;
    bottom: -30%;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    opacity: 0.5;
    filter: blur(6px);
  }

  .kicker {
    position: relative;
    z-index: 1;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    position: relative;
    z-index: 1;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: #f2f5f9;
  }

  /* Per-subject hues, used on the record label, the kicker and the glow. */
  .rust .vlabel {
    background: radial-gradient(circle at 35% 30%, #e39a72, #c05f37);
  }
  .rust .kicker {
    color: #e0956b;
  }
  .rust .cover::after {
    background: #c05f37;
  }

  .green .vlabel {
    background: radial-gradient(circle at 35% 30%, #8bc48f, #4f9a57);
  }
  .green .kicker {
    color: #7cbd82;
  }
  .green .cover::after {
    background: #4f9a57;
  }

  .plum .vlabel {
    background: radial-gradient(circle at 35% 30%, #c99ac6, #9a5f97);
  }
  .plum .kicker {
    color: #c297bf;
  }
  .plum .cover::after {
    background: #9a5f97;
  }

  .teal .vlabel {
    background: radial-gradient(circle at 35% 30%, #6fc0c4, #2f9296);
  }
  .teal .kicker {
    color: #5fb3b7;
  }
  .teal .cover::after {
    background: #2f9296;
  }

  /* Hover and keyboard focus lift the record partway out. */
  .item[href]:hover .vinyl,
  .item[href]:focus-visible .vinyl {
    top: -46%;
  }

  .item[href]:hover .cover,
  .item[href]:focus-visible .cover {
    box-shadow: 0 12px 26px rgba(13, 27, 42, 0.36);
  }

  .item[href]:focus-visible .cover {
    outline: 2px solid var(--accent-2);
    outline-offset: 3px;
  }

  .item[href]:focus-visible {
    outline: none;
  }

  /* On click, the record slides the rest of the way out before redirect. */
  .item.playing .vinyl {
    top: -104%;
  }

  /* Coming-soon sleeves: dimmed, no record, not interactive. */
  .item.soon {
    cursor: default;
  }
  .item.soon .cover {
    opacity: 0.62;
    box-shadow: 0 6px 14px rgba(13, 27, 42, 0.18);
  }
  .item.soon .title {
    color: #c6cedb;
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl {
      transition: none;
    }
  }
</style>
