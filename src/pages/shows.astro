---
import Layout from '../layouts/Layout.astro';

// My top 5, in order. Short because I have not watched enough shows to rank
// further than that yet; it grows as I do. `note` is a one-line reason, and an
// empty note renders without one. `year` is the run and prints as written.
const shows = [
  { title: 'Breaking Bad', year: '2008-2013', note: '' },
  { title: 'Atlanta', year: '2016-2022', note: '' },
  { title: 'The Sopranos', year: '1999-2007', note: '' },
  { title: 'Avatar: The Last Airbender', year: '2005-2008', note: '' },
  { title: 'Better Call Saul', year: '2015-2022', note: '' },
];

// Unranked, in no particular order.
const mentions = [
  { title: 'Game of Thrones', year: '2011-2019' },
  { title: 'The Office', year: '2005-2013' },
  { title: 'The Bear', year: '2022-present' },
];
---

<Layout
  title="Top 5 Shows | Joe Fazio"
  description="Joe Fazio's five favorite TV shows, plus a few honorable mentions."
>
  <p class="back"><a href="/records">Back to The Record Store</a></p>

  <h1>Joe's Top 5 Shows</h1>
  <p class="lede">
    My five favorite TV shows. Only five, because I have not watched enough to
    rank further than that honestly. Ranked on whether the story held up from
    the first season to the last. The list grows as I keep watching.
  </p>

  <ol class="ranked">
    {
      shows.map((s, i) => (
        <li>
          <span class="rank">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">
              {s.title} <span class="year">({s.year})</span>
            </span>
            {s.note && <span class="note">{s.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>

  <h2>Honorable mentions</h2>

  <ul class="ranked mentions">
    {
      mentions.map((s) => (
        <li>
          <span class="title">
            {s.title} <span class="year">({s.year})</span>
          </span>
        </li>
      ))
    }
  </ul>

  <p class="back"><a href="/records">Back to The Record Store</a></p>
</Layout>

<style>
  .back {
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .lede {
    color: var(--dim);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .ranked {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .ranked li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ranked li:last-child {
    border-bottom: none;
  }

  .rank {
    flex: 0 0 2.1rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* The year sits quietly beside the title. */
  .year {
    font-weight: 400;
    color: var(--dim);
  }

  .note {
    font-size: 0.85rem;
    color: var(--dim);
    line-height: 1.55;
  }

  h2 {
    margin: 0 0 0.5rem;
  }
</style>
