---
// A small record (or CD) that links an album to its copy in the record
// collection. The label shows on hover and keyboard focus; screen readers get
// it from aria-label. On a phone there is no hover, so a tap just goes there.
interface Props {
  slug: string;
  cd?: boolean;
}

const { slug, cd = false } = Astro.props;
const label = cd ? 'Put it in the CD player' : 'Put it on the turntable';
---

<a class:list={['spin', { cd }]} href={`/collection?play=${slug}`} aria-label={label} data-tip={label}>
  {
    cd ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="11" class="disc" />
        <circle cx="12" cy="12" r="7.5" class="sheen" />
        <circle cx="12" cy="12" r="3.2" class="hub" />
        <circle cx="12" cy="12" r="1.3" class="hole" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="11" class="disc" />
        <circle cx="12" cy="12" r="8.4" class="groove" />
        <circle cx="12" cy="12" r="6.6" class="groove" />
        <circle cx="12" cy="12" r="4" class="label" />
        <circle cx="12" cy="12" r="0.9" class="hole" />
      </svg>
    )
  }
</a>

<style>
  .spin {
    position: relative;
    display: inline-grid;
    place-items: center;
    vertical-align: middle;
    width: 1.6rem;
    height: 1.6rem;
    margin: -0.2rem 0 -0.2rem 0.15rem;
    border-radius: 50%;
    text-decoration: none;
  }

  svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .disc {
    fill: #15161a;
    stroke: color-mix(in srgb, var(--dim) 45%, transparent);
    stroke-width: 0.6;
  }
  .groove {
    fill: none;
    stroke: #3a3d45;
    stroke-width: 0.5;
  }
  .label {
    fill: var(--accent);
  }
  .hole {
    fill: var(--bg);
  }

  .cd .disc {
    fill: #c9ccd2;
    stroke: #8e939c;
  }
  .cd .sheen {
    fill: none;
    stroke: #eef0f3;
    stroke-width: 2.2;
    opacity: 0.7;
  }
  .cd .hub {
    fill: #a9adb5;
  }

  /* The tip opens to the right, in the empty space after the title. */
  .spin::after {
    content: attr(data-tip);
    position: absolute;
    left: calc(100% + 0.35rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    font-weight: 400;
    white-space: nowrap;
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
    background: var(--fg);
    color: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }

  .spin:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .spin:focus-visible::after {
    opacity: 1;
  }

  @media (hover: hover) {
    .spin:hover::after {
      opacity: 1;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .spin:hover svg {
      animation: turn 1.8s linear infinite;
    }
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>
