# Dependencies and build output (regenerated by npm ci / npm run build)
node_modules/
dist/
.astro/

# Logs and OS clutter
npm-debug.log*
.DS_Store
Thumbs.db

# Private notes for Claude Code (kept local, not public)
CLAUDE.md
